{
  "name": "@clover-book/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./trpc": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:import": "bun test tests/suishouji-import.test.ts",
    "test": "bun test tests/",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@clover-book/core": "workspace:*",
    "@hono/trpc-server": "^0.3.0",
    "@trpc/server": "^11.0.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "postgres": "^3.4.0",
    "proper-lockfile": "^4.1.0",
    "superjson": "^2.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/proper-lockfile": "^4.1.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.5.0"
  }
}
